# ── Supabase ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only — never prefix service-role keys with VITE_
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# ── Ollama AI ──────────────────────────────────────────────────────────────────
# IMPORTANT: Do NOT use VITE_ prefix for OLLAMA_BASE_URL. A VITE_ prefix would
# embed the URL into the browser bundle, leaking your Ollama endpoint to the
# public. Server-side functions (Edge Functions / Netlify) read this directly.
OLLAMA_BASE_URL=http://192.168.1.42:11434
OLLAMA_MODEL=gemma3:4b

# In dev mode, ChatWidget calls Ollama directly from the browser and needs the
# URL. Only set this in your local .env (never commit to the repo):
# VITE_OLLAMA_BASE_URL=http://192.168.1.42:11434

# ── Dev Server (optional) ─────────────────────────────────────────────────────
VITE_DEV_HOST=127.0.0.1
VITE_ALLOWED_HOSTS=
