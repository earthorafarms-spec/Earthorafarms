# ── Supabase ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only — never prefix service-role keys with VITE_
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# ── Ollama AI ──────────────────────────────────────────────────────────────────
# VITE_ prefix = accessible in the browser (required for ChatWidget streaming)
# Set this to your Ollama machine's local IP or public domain
# Example local network : VITE_OLLAMA_BASE_URL=http://192.168.1.42:11434
# Example Cloudflare tunnel: VITE_OLLAMA_BASE_URL=https://your-tunnel.trycloudflare.com
VITE_OLLAMA_BASE_URL=https://albert-anonymous-birmingham-wizard.trycloudflare.com

# Server-side only (for Edge Functions / backend — no VITE_ prefix)
OLLAMA_BASE_URL=https://albert-anonymous-birmingham-wizard.trycloudflare.com
OLLAMA_MODEL=gemma3:4b

# ── Dev Server (optional) ─────────────────────────────────────────────────────
VITE_DEV_HOST=127.0.0.1
VITE_ALLOWED_HOSTS=
