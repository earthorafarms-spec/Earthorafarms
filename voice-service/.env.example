# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins for CORS (verification form, harness)
PUBLIC_APP_URL=http://localhost:5173
# Public HTTPS base of this service. Signed WhatsApp invoice links use this
# route directly so they always download a PDF instead of the storefront SPA.
PUBLIC_VOICE_SERVICE_URL=https://earthorafarms-mhwv.onrender.com
LOG_LEVEL=debug
# Base URL of the main storefront's Netlify deploy — used only to fire the
# existing send-invoice function after a voice order finalizes. Optional.
MAIN_APP_NETLIFY_URL=https://earthorafarms.netlify.app
NETLIFY_INTERNAL_KEY=

# ── Supabase (service-role only — this is a server, never expose to a browser) ─
# Same Supabase project as the main storefront app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── LLM provider selection (see src/providers.ts) ─────────────────────────────
# openai = gpt-4o-mini (default). sarvam = better at Hindi/Gujarati compliance
# in testing, since it's built specifically for Indian languages.
LLM_PROVIDER=openai

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_REALTIME_STT_MODEL=gpt-live-transcribe

# OpenAI handles all incoming speech by default, so English calls continue
# even if Sarvam has no remaining balance. Hindi/Gujarati still prefer Sarvam
# for TTS in auto mode and fall back to OpenAI if Sarvam fails.
STT_PROVIDER=openai
TTS_PROVIDER=auto

# -- Self-hosted GPU server (set any *_PROVIDER above to "plymaxx") ----------
# Qwen3.5 9B + Whisper + IndicConformer + Piper + Indic Parler, behind a
# model-selectable OpenAI-shaped API. ALL THREE languages run here; nothing
# falls back to a paid vendor. Choosing "plymaxx" means a GPU outage surfaces
# as an error rather than a silent bill -- TTS_PROVIDER=auto is the hosted
# alternative if you want that resilience instead.
#
# Never expose AI_API_KEY to a browser bundle. On this machine the credential
# helper writes these values into a gitignored file:
#   & 'C:\Users\<you>\.config\plymaxx-voicebot\Write-ProjectEnv.ps1' -OutputPath .env.plymaxx.local
AI_BASE_URL=
AI_API_KEY=
AI_LLM_MODEL=qwen3.5:9b
# The server clamps generation at 256 tokens and truncates silently past it.
AI_MAX_OUTPUT_TOKENS=256

# Model-selectable endpoints. Paths resolve against AI_BASE_URL. Do NOT point
# these at the legacy /audio/speech/stream route: there, model=indic-parler-tts
# is an old label for Piper, so English would be spoken by a Hindi voice.
AI_TRANSCRIBE_URL=/audio/transcriptions
AI_SPEECH_URL=/audio/speech

# Recognition, chosen per utterance. Whisper covers 100 languages plus
# auto-detection; the Indic conformer is preferred for Gujarati and rejects
# English with 422. AUTO is used until the caller's language is known.
AI_STT_MODEL_EN=whisper-large-v3-turbo
AI_STT_MODEL_HI=whisper-large-v3-turbo
AI_STT_MODEL_GU=indic-conformer-600m-multilingual
AI_STT_MODEL_AUTO=whisper-large-v3-turbo

# Synthesis, chosen per reply. Piper streams at 22.05 kHz (~0.2 s to first
# audio) but only Hindi and Gujarati checkpoints are installed. Parler has 68
# named speakers at 44.1 kHz including English, but returns COMPLETED audio
# (~1.2-1.5 s for a short phrase), so English starts speaking later.
# piper-hi-rohan / piper-gu-male are the real checkpoints; Divya, Neha, Rohit
# and Yash are aliases onto them, not separate voices.
# Check any change against the live catalogue: GET /v1/audio/voices
AI_TTS_MODEL_EN=indic-parler-tts
AI_TTS_VOICE_EN=Thoma
AI_TTS_MODEL_HI=piper
AI_TTS_VOICE_HI=piper-hi-rohan
AI_TTS_MODEL_GU=piper
AI_TTS_VOICE_GU=piper-gu-male
# Longer deadline for a completed-audio model queued behind another project.
AI_TTS_COMPLETED_TIMEOUT_MS=30000

# ── Sarvam (alternate LLM_PROVIDER — required only if LLM_PROVIDER=sarvam) ────
SARVAM_API_KEY=
# Ordered keys; when non-empty this replaces SARVAM_API_KEY. Server secret only.
# Use independently funded, authorized keys. Keys on an empty shared wallet all fail.
SARVAM_API_KEYS=
# Skip exhausted keys for five minutes; then allow rechecking after a top-up.
SARVAM_KEY_COOLDOWN_MS=300000
SARVAM_MODEL=sarvam-105b
SARVAM_TTS_SPEAKER=neha
# Priya is Sarvam's recommended production female voice for Hindi and Gujarati.
SARVAM_TTS_HINDI_SPEAKER=priya
SARVAM_TTS_GUJARATI_SPEAKER=priya
# A natural middle ground: 0.1 sounds overly synthetic; 0.6 can be less stable.
SARVAM_TTS_TEMPERATURE=0.45
# Public Tata/VOICE Streaming bot socket (production must use wss://)
VOICE_STREAM_PUBLIC_WSS_URL=
# Stream Smartflo's native G.711 audio into transcription while callers speak.
# If the realtime socket fails, each turn automatically uses OPENAI_STT_MODEL.
VOICE_REALTIME_STT_ENABLED=false
VOICE_END_OF_SPEECH_MS=850
VOICE_NUMERIC_END_OF_SPEECH_MS=1100

# ── WhatsApp delivery ────────────────────────────────────────────────────────
# Use tata_omni when the business number is managed in Tata Omni. Generate the
# token in Omni under Settings > Account Settings > API Keys.
WHATSAPP_PROVIDER=tata_omni
TATA_OMNI_ACCESS_TOKEN=
TATA_OMNI_API_BASE_URL=https://wb.omni.tatatelebusiness.com
# Use this in X-Webhook-Secret, or as ?token=... when Omni only accepts a URL.
TATA_OMNI_WEBHOOK_SECRET=
# Meta values remain supported for direct Cloud API and inbound chat.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Recommended for voice-call follow-ups. Create an approved template whose
# body contains one {{1}} placeholder for the review-form URL.
WHATSAPP_CHECKOUT_TEMPLATE_NAME=
WHATSAPP_CHECKOUT_TEMPLATE_LANGUAGE=en
# Approved utility template with {{1}} product, {{2}} current stock, and {{3}} threshold.
WHATSAPP_LOW_STOCK_TEMPLATE_NAME=earthora_low_stock_alert
WHATSAPP_LOW_STOCK_TEMPLATE_LANGUAGE=en
WHATSAPP_INVOICE_TEMPLATE_NAME=
WHATSAPP_INVOICE_TEMPLATE_LANGUAGE=en

# ── Google Cloud STT/TTS — NOT YET AVAILABLE, leave blank ─────────────────────
# Adapters throw "not configured" until these are set; the text-mode harness
# works fully without them. Fill these in later to enable real voice audio.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_STT_LANGUAGE_CODE=en-IN
GOOGLE_TTS_LANGUAGE_CODE=en-IN
GOOGLE_TTS_VOICE_NAME=

# ── Razorpay (test mode) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your-test-key-secret
# Set this in the Razorpay dashboard when you configure the webhook URL
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ── Resend ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Earthora Farms <orders@earthorafarms.com>

# ── Security — generate fresh values, do not reuse across environments ───────
# 32+ byte random string, e.g: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SIGNING_SECRET=
# Exactly 32 bytes (64 hex chars) for AES-256-GCM, same generation command as above
PII_ENCRYPTION_KEY=
VOICE_CHECKOUT_TTL_MINUTES=30
