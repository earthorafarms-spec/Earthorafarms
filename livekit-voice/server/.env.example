# server/.env — copy to `.env` on the voice box and fill in.
#
# Upstream never shipped an env.example (its README's `cp env.example
# server/.env` refers to a file that does not exist), so this was derived by
# reading agent.py / token_server.py / services/*.py. Every default below is
# what the code falls back to when the variable is unset — several of those
# defaults point at SchoolExl infrastructure, so leaving them unset is NOT
# the same as disabling them. The ones marked REQUIRED have no usable default.

# ─────────────────────────────────────────────────────────────────────────────
# LiveKit — must match livekit/livekit.yml on this box
# ─────────────────────────────────────────────────────────────────────────────
# Where the agent + token server reach the SFU. With `network_mode: host` and
# LiveKit on the same box this can be ws://127.0.0.1:7880.
# Code default is wss://lk.scoreexl.com — SchoolExl's SFU. Set it.
LIVEKIT_URL=ws://127.0.0.1:7880
# What the BROWSER is told to connect to. Public, TLS, through your reverse
# proxy. Defaults to LIVEKIT_URL, which would hand clients an unreachable
# loopback address — set it explicitly.
LIVEKIT_PUBLIC_URL=wss://lk.your-domain.com
# REQUIRED. Key/secret pair; the same pair must appear under `keys:` in
# livekit/livekit.yml. Generate: `docker run --rm livekit/livekit-server generate-keys`
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Token server auth
# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED. The shared bearer that gates /api/start and /api/verify. This is
# the value UniExl's API holds as VOICE_ADDON_TOKEN in /srv/uniexl/.env — the
# two must match exactly. Generate: `openssl rand -hex 32`
SERVER_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# AI vendors — all cloud, all REQUIRED for a working turn loop
# ─────────────────────────────────────────────────────────────────────────────
# Read by the LiveKit plugins themselves, not by agent.py, so they do not
# appear in any os.getenv() call — they are still mandatory.
OPENAI_API_KEY=          # LLM: gpt-4.1
DEEPGRAM_API_KEY=        # STT: nova-3

# TTS: Google Cloud Chirp3-HD. Path to the service-account JSON, resolved
# relative to the agent directory. compose.yml mounts ./google:/app/google:ro,
# so put the key at server/google/<file>.json and point here.
# server/google/ is gitignored (`**/google/`) — it must never be committed.
GOOGLE_APPLICATION_CREDENTIALS=google/your-service-account.json

# ─────────────────────────────────────────────────────────────────────────────
# Safety screening — READ THIS ONE
# ─────────────────────────────────────────────────────────────────────────────
# agent.py screens every spoken turn through
#   {BACKEND_URL}/api/v2/internal/voice-safety-check
# The code default is https://core.schoolexl.in — SchoolExl's Laravel app.
# Unset here means your students' utterances are POSTed to their backend.
#
# Point it at a UniExl-owned endpoint that implements the same contract, or
# leave it pointing somewhere that 404s and accept degraded mode: the gate
# fails OPEN with a local high-precision self-harm floor (EN/HI/GU keywords in
# agent.py) that still catches an unambiguous crisis utterance and replies with
# the Tele-MANAS 14416 message. Ordinary academic turns pass through.
# Do not "fix" that into fail-closed — upstream commit d7cc9072 removed
# fail-closed precisely because a 404 silenced all student voice.
BACKEND_URL=https://core.schoolexl.in
VOICE_SAFETY_SECRET=     # bearer sent to the safety endpoint

# ─────────────────────────────────────────────────────────────────────────────
# Turn-loop tuning — production fixes, change only deliberately
# ─────────────────────────────────────────────────────────────────────────────
# At 1, a phone speaker's echo of the agent's own TTS satisfied the interrupt
# threshold and the session looped forever. 3 is the fix.
VOICE_MIN_INTERRUPT_WORDS=3
# Bounds a forgotten tab. Session closes with a goodbye at this many turns.
VOICE_MAX_TURNS_PER_SESSION=50

# ─────────────────────────────────────────────────────────────────────────────
# Optional GPU services (RunPod). Omit the whole block for voice-only.
# ─────────────────────────────────────────────────────────────────────────────
# Ditto talking-head avatar. Code default is a SchoolExl RunPod pod URL that
# you do not control and that will rotate — set or ignore, never rely on it.
# DITTO_API_URL=https://<your-pod>-8181.proxy.runpod.net
# DITTO_API_KEY=
# DITTO_AVATAR_ID=imogen
# DITTO_BACKEND=

# Vision (SmolVLM :8282). Enables the agent's camera/screen tools.
# SMOLVLM_URL=http://127.0.0.1:8282
# VLM_URL=
# MOONDREAM_URL=

# Local TTS (Chatterbox :8081). Leave unset to use Google Chirp3-HD.
# TTS_URL=

# Avatar asset paths (defaults are fine unless you moved them)
# AVATAR_IMAGES_DIR=
# AVATAR_CLIPS_DIR=
# AVATAR_CACHE_DIR=

# Hosted avatar vendors — alternatives to self-hosted Ditto
# BEY_API_KEY=
# BEY_API_URL=
# BEY_AVATAR_ID=
# TAVUS_API_KEY=
# TAVUS_REPLICA_ID=
# TAVUS_PERSONA_ID=

# Lecture visual-board protocol (see server/visual_board_protocol.py)
# SX_VISUAL_BOARD=
