# Ignore rules for the voice-service image only. BuildKit prefers this file
# over the context's .dockerignore, which is written for the API image and
# excludes voice-service/ and whatsapp-chatbot/ outright.
**/node_modules
**/dist
**/dist-whatsapp
**/.env
**/.env.local
.git
.github

# Other applications in this monorepo — not part of this image.
apps
supabase
netlify
output
tmp
infra

# Not needed to build or run the service.
voice-service/tests
voice-service/scripts
**/*.md
