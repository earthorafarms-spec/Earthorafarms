# Earthora Farms — Voice Agent Server Environment Variables

# Server Configuration
PORT=8080

# Tata SmartFlo Webhook & Audio Streaming Configuration
# Header validation secret sent by SmartFlo in X-SmartFlo-Signature or Authorization header
SMARTFLO_WEBHOOK_SECRET=your-smartflo-webhook-secret

# Audio Stream Specs (Default μ-law 8000Hz or PCM 16000Hz per SmartFlo carrier docs)
SMARTFLO_AUDIO_ENCODING=mulaw
SMARTFLO_SAMPLE_RATE=8000

# ── Primary Speech & AI Providers (Sarvam AI & Anthropic) ──────────────────────
SARVAM_API_KEY=
SARVAM_USE_LLM=false          # set true to use Sarvam's own LLM gateway instead of Anthropic
ANTHROPIC_API_KEY=

# ── Local PC Fallback Services (Cloudflare Tunnel URLs) ────────────────────────
LOCAL_STT_URL=http://127.0.0.1:8001      # Cloudflare Tunnel URL pointing to faster-whisper (port 8001)
LOCAL_TTS_URL=http://127.0.0.1:8002      # Cloudflare Tunnel URL pointing to Piper TTS (port 8002)
LOCAL_LLM_URL=http://127.0.0.1:11434     # Cloudflare Tunnel URL pointing to Ollama (port 11434)
LOCAL_LLM_MODEL=qwen2.5:7b

# ── Razorpay Payment Links & Webhooks ──────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
WEBSITE_URL=https://earthorafarms.com

# ── SMS & WhatsApp Notifications ───────────────────────────────────────────────
SMARTFLOW_API_KEY=
SMARTFLOW_SENDER_ID=
SMARTFLOW_BASE_URL=https://smartflow.tatacommunications.com/api/v1
TATA_WHATSAPP_API_KEY=          # optional — leave blank if not available yet
META_WHATSAPP_TOKEN=            # optional — leave blank if not Meta-approved yet
META_WHATSAPP_PHONE_NUMBER_ID=  # optional
