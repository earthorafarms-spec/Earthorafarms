FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 HF_HOME=/opt/models
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
# Pinned LiveKit runtime for the MSH/SunPath voice adaptation.
# The VPS handles media/VAD; inference continues on the existing RTX server.
RUN pip install --no-cache-dir torch==2.5.1 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir 'livekit-agents==1.3.12' 'livekit-plugins-silero==1.3.12' \
    'livekit-plugins-openai==1.3.12' \
    'livekit-plugins-turn-detector==1.3.12' 'livekit==1.0.23' 'livekit-api==1.1.0' \
    'fastapi==0.128.0' 'uvicorn[standard]==0.40.0' 'websockets==15.0.1' 'httpx==0.28.1' 'python-dotenv==1.2.1' \
    'transformers==4.57.1' 'huggingface-hub==0.36.0' 'onnxruntime==1.23.1' \
    'pytest>=8,<9' 'pytest-asyncio>=0.23,<1'
COPY . .
RUN python earthora_agent.py download-files
CMD ["python", "earthora_agent.py", "start"]
