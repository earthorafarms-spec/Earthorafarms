/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://*.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.razorpay.com; font-src 'self' https://fonts.gstatic.com https://*.razorpay.com; img-src 'self' data: blob: https://*.razorpay.com; media-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://ipwho.is https://*.razorpay.com; frame-src https://*.razorpay.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
