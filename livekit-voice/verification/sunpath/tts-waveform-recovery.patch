+def _generate_complete_waveform(generate, deadline, max_samples):
+    """Reject an entire bad result; one retry shares the original time/step budget."""
+    import numpy as np
+
+    for attempt in range(2):
+        if time.monotonic() >= deadline.until:
+            return "timeout", None
+        audio = generate()
+        if deadline.expired or deadline.exhausted:
+            del audio
+            return ("timeout" if deadline.expired else "length"), None
+        waveform = audio.detach().float().cpu().numpy().squeeze()
+        del audio
+        if waveform.size == 0:
+            reason = "empty"
+        elif waveform.ndim != 1:
+            reason = "shape"
+        elif waveform.size > max_samples:
+            reason = "length"
+        elif not np.isfinite(waveform).all():
+            reason = "nonfinite"
+        else:
+            return "ok", waveform
+        # Fixed reason codes and numeric counters only: never text or sample values.
+        print(f"TTS waveform rejected reason={reason} attempt={attempt + 1} "
+              f"dimensions={waveform.ndim} samples={waveform.size} limit={max_samples}",
+              file=sys.stderr, flush=True)
+        del waveform
+        if reason == "length":
+            return "length", None
+        if reason == "nonfinite":
+            return "invalid", None
+        # Empty/shape results may be stochastic. Do not reset deadline.until or
+        # its cumulative decoder steps, and do not change text, voice or sampling.
+    return "invalid", None
+
